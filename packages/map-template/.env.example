VITE_MAPBOX_ACCESS_TOKEN=mapbox access token
VITE_GOOGLE_MAPS_API_KEY=google maps api key
# AI chat server URL. Required: without it chat requests fail.
# For local development put it in .env.development.local, so `vite build` and `npm run build-for-npm` never pick it up.
# Releases read it from the GitHub Actions repository secret VITE_CHAT_API_URL.
# VITE_CHAT_API_URL=http://localhost:4000
